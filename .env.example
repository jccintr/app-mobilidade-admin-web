# Endereço da API
VITE_API_URL=http://localhost:3333
# Slug da operadora (em produção, se vazio, usa o subdomínio: operadora.painel.com)
VITE_TENANT=demo
# Mapa: endereço dos tiles. O padrão (OpenStreetMap) é só para desenvolvimento; em produção use um provedor com plano comercial.
# VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_TILE_ATTRIBUTION=© OpenStreetMap
# Centro inicial do mapa quando ainda não há dados (lat,lng)
# VITE_MAP_CENTER=-21.55,-45.43
